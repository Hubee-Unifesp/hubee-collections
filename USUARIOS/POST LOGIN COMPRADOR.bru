meta {
  name: POST LOGIN COMPRADOR
  type: http
  seq: 8
}

docs {
  Login de um usuário comum (role = USER) sem vínculo aceito em nenhuma
  organização. Salva o JWT em {{tokenComprador}}.
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "email": "{{emailComprador}}",
    "password": "{{senhaComprador}}"
  }
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setEnvVar("tokenComprador", res.getBody().access_token);
  }
}

tests {
  test("responde 200 com access_token", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody().access_token).to.be.a("string");
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
