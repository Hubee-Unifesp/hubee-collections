meta {
  name: GET PERFIL ME
  type: http
  seq: 9
}

docs {
  Dados do usuário logado com as organizações em que ele tem vínculo aceito.
  Rode antes o POST LOGIN ORGANIZADOR.
}

get {
  url: {{baseUrl}}/users/me
  body: none
  auth: bearer
}

auth:bearer {
  token: {{tokenOrganizador}}
}

tests {
  test("responde 200 sem expor a senha", function () {
    expect(res.getStatus()).to.equal(200);
    expect(res.getBody()).to.not.have.property("password");
  });

  test("lista as organizações com papel, permissão e nível", function () {
    const organizations = res.getBody().organizations;
    expect(organizations).to.be.an("array").that.is.not.empty;
    organizations.forEach(function (org) {
      expect(org).to.include.all.keys("orgId", "organizationName", "role", "permission", "level");
      expect(["read", "write", "manage"]).to.include(org.level);
    });
  });

  test("tem acesso de escrita na organização usada nos testes de eventos", function () {
    const org = res.getBody().organizations.find(function (o) {
      return o.orgId === bru.getEnvVar("organizerId");
    });
    expect(org, "organizerId do ambiente não está em organizations").to.exist;
    expect(["write", "manage"]).to.include(org.level);
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
