meta {
  name: POST LOCAL
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/locais
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Centro de Eventos Kimi",
    "maxCapacity": 100,
    "address": {
      "zipCode": "12220-140",
      "street": "rua patativa",
      "number": "100",
      "complement": "Sala 5",
      "neighborhood": "Bela Vista",
      "city": "São José dos Campos",
      "state": "SP",
      "country": "Brasil"
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
