meta {
  name: POST LOCAL
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/locais
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Centro de Eventos Hubee",
    "maxCapacity": 500,
    "address": {
      "zipCode": "01310-100",
      "street": "Avenida Paulista",
      "number": "1000",
      "complement": "Sala 5",
      "neighborhood": "Bela Vista",
      "city": "São Paulo",
      "state": "SP",
      "country": "Brasil"
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
