meta {
  name: POST CRIAR EVENTO
  type: http
  seq: 1
}

docs {
  Organizador com nível write ou manage na organização {{organizerId}} cria um
  evento. O evento nasce como rascunho (draft).
}

post {
  url: {{baseUrl}}/events
  body: json
  auth: bearer
}

auth:bearer {
  token: {{tokenOrganizador}}
}

body:json {
  {
    "name": "Calourada Hubee",
    "description": "Evento criado pela coleção do Bruno (GOL-147).",
    "organizerId": "{{organizerId}}",
    "venueId": "{{venueId}}",
    "startDate": "2027-03-20T19:00:00.000Z",
    "endDate": "2027-03-21T02:00:00.000Z",
    "salesStartDate": "2027-02-01T12:00:00.000Z",
    "category": "Festa"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setEnvVar("eventId", res.getBody().id);
  }
}

tests {
  test("responde 201", function () {
    expect(res.getStatus()).to.equal(201);
  });

  test("evento pertence à organização do organizador", function () {
    expect(res.getBody().organizerId).to.equal(bru.getEnvVar("organizerId"));
  });
}

settings {
  encodeUrl: true
  timeout: 0
}
